    m_Metadata:
      m_Items: []
  - m_Id: 4000000309
    m_Localized: Строит лестницу.
    m_Metadata:
      m_Items: []
  - m_Id: 4000000310
    m_Localized: Строит жилой модуль.
    m_Metadata:
      m_Items: []

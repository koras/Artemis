    m_Metadata:
      m_Items: []
  - m_Id: 56025645309956
    m_Localized: Hold both power and production in an operational state for 1 sol.
    m_Metadata:
      m_Items: []
  - m_Id: 56025645309957
    m_Localized: Maintain 1 operational Electric Battery for 1 sol.
    m_Metadata:
      m_Items: []
  - m_Id: 56025645309958
    m_Localized: Maintain 1 operational Regolith Processing Unit for 1 sol.
    m_Metadata:

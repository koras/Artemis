    border-top-color: rgba(201, 160, 107, 0.35);
}

.task-row {
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.task-row-title {
    font-size: 14px;
    color: rgb(255, 255, 255);
}

.task-row-meta {
    font-size: 12px;
    color: rgb(200, 200, 200);
}

.task-row-empty {
    font-size: 13px;
    color: rgb(180, 180, 180);
}

.shop-table-row.shop-category-food {
    background-color: rgba(116, 181, 102, 0.22);
}

.shop-table-row.shop-category-equipment {
    background-color: rgba(104, 160, 214, 0.22);
}

.shop-table-row.shop-category-personnel {
    background-color: rgba(214, 165, 102, 0.22);
}

.hud-top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(12, 16, 24, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(126, 135, 149, 0.6);
    border-right-color: rgba(27, 31, 39, 0.9);
    border-top-color: rgba(126, 135, 149, 0.6);
    border-bottom-color: rgba(27, 31, 39, 0.9);
    gap: 24px;
}

.hud-left-controls {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.time-control-btn {
    min-width: 42px;
    height: 34px;
    padding-left: 0;
    padding-right: 0;
    background-color: rgb(53, 59, 69);
    color: rgb(240, 245, 255);
    unity-font-style: bold;
}

.time-control-btn:hover {
    background-color: rgb(126, 135, 149);
    color: rgb(16, 19, 26);
}

.time-control-btn-active {
    background-color: rgb(168, 80, 0);
    color: rgb(255, 255, 255);
}

.game-time-panel {
    position: relative;
    right: auto;
    top: auto;
    width: auto;
    padding: 0;
    background-color: transparent;
}

#game-time-label {
    color: rgb(220, 232, 255);
    font-size: 16px;
}

.resource-inventory-panel {
    position: absolute;
    left: 16px;
    top: 76px;
    width: 260px;
    padding: 10px;
    background-color: rgba(12, 16, 24, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(126, 135, 149, 0.6);
    border-right-color: rgba(27, 31, 39, 0.9);
    border-top-color: rgba(126, 135, 149, 0.6);
    border-bottom-color: rgba(27, 31, 39, 0.9);
    flex-direction: column;
    align-items: stretch;
}

#resource-inventory-title {
    margin-bottom: 8px;
    margin-right: 0;
    color: rgb(220, 232, 255);
    font-size: 15px;
    unity-font-style: bold;
}

.resource-inventory-list {
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
}

.resource-row {
    position: relative;
    margin-bottom: 0;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.resource-icon {
    width: 22px;
    height: 22px;
    unity-text-align: middle-center;
    unity-font-style: bold;
    color: rgb(16, 19, 26);
    background-color: rgb(126, 135, 149);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.resource-row-amount {
    min-width: 52px;
    font-size: 13px;
    color: rgb(240, 245, 255);
    unity-text-align: middle-right;
    margin-left: auto;
}

.resource-row-name {
    display: flex;
    color: rgb(220, 232, 255);
    font-size: 13px;
    flex-grow: 1;
}

.resource-tooltip {
    position: absolute;
    top: 32px;
    left: 0;
    display: none;
    padding: 5px 7px;
    background-color: rgba(16, 19, 26, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 135, 149);
    border-right-color: rgb(27, 31, 39);
    border-top-color: rgb(126, 135, 149);
    border-bottom-color: rgb(27, 31, 39);
    max-width: 280px;
}

#resource-tooltip-label {
    white-space: normal;
    color: rgb(227, 238, 255);
    font-size: 12px;
}

.hud-right-controls {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.shop-open-btn {
    position: relative;
    left: auto;
    top: auto;
    margin-left: 0;
    min-width: 120px;
    height: 34px;
}

.offers-open-btn {
    position: relative;
    right: auto;
    top: auto;
    min-width: 120px;
    height: 34px;
}

.task-queue-panel {
    right: 16px;
    left: auto;
    top: 96px;
}

.bottom-bar-main {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    background-color: rgba(12, 16, 24, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(126, 135, 149, 0.6);
    border-right-color: rgba(27, 31, 39, 0.9);
    border-top-color: rgba(126, 135, 149, 0.6);
    border-bottom-color: rgba(27, 31, 39, 0.9);
}

.bottom-bar-left,
.bottom-bar-right {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.bottom-menu-btn {
    min-width: 80px;
}

.bottom-popup-panel {
    position: absolute;
    left: 16px;
    bottom: 108px;
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background-color: rgba(12, 16, 24, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 135, 149);
    border-right-color: rgb(27, 31, 39);
    border-top-color: rgb(126, 135, 149);
    border-bottom-color: rgb(27, 31, 39);
}

.bottom-popup-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.bottom-popup-panel.open {
    display: flex;
}

.tool-panel {
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: none;
}

.tool-panel Button {
    min-width: 88px;
    height: 30px;
    font-size: 12px;
}

.menu-icon-btn {
    min-width: 80px;
    width: 80px;
    height: 84px;
    padding-top: 56px;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 12px;
    font-size: 10px;
    white-space: normal;
    unity-text-align: upper-center;
    -unity-font-style: bold;
    background-position-x: center;
    background-position-y: 4px;
    background-repeat: no-repeat;
    background-size: 52px 52px;
    background-color: rgb(64, 72, 84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(151, 162, 179);
    border-right-color: rgb(31, 38, 49);
    border-top-color: rgb(178, 189, 206);
    border-bottom-color: rgb(31, 38, 49);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: rgb(236, 241, 249);
}

.menu-icon-btn:hover {
    background-color: rgb(86, 97, 112);
    border-left-color: rgb(187, 198, 216);
    border-right-color: rgb(43, 51, 65);
    border-top-color: rgb(198, 209, 227);
    border-bottom-color: rgb(43, 51, 65);
}

.menu-icon-btn:active {
    background-color: rgb(52, 59, 70);
    border-left-color: rgb(118, 129, 145);
    border-right-color: rgb(27, 33, 43);
    border-top-color: rgb(118, 129, 145);
    border-bottom-color: rgb(27, 33, 43);
}

.character-diagnostics-panel {
    position: absolute;
    right: 16px;
    top: 76px;
    width: 340px;
    max-height: 72%;
    padding: 10px;
    background-color: rgba(12, 16, 24, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(126, 135, 149, 0.6);
    border-right-color: rgba(27, 31, 39, 0.9);
    border-top-color: rgba(126, 135, 149, 0.6);
    border-bottom-color: rgba(27, 31, 39, 0.9);
}

.character-roster-panel {
    position: absolute;
    right: 360px;
    top: 4px;
    width: auto;
    max-width: 260px;
    margin-left: 0;
    padding: 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.character-diagnostics-title {
    color: rgb(220, 232, 255);
    unity-font-style: bold;
    margin-bottom: 8px;
}

.character-diagnostics-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.character-diagnostics-close-btn {
    min-width: 24px;
    width: 24px;
    height: 22px;
    padding-left: 0;
    padding-right: 0;
}

.character-diagnostics-list {
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 4px;
    width: auto;
}

.character-diagnostics-item {
    min-width: 32px;
    width: 32px;
    height: 32px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(53, 59, 69, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 135, 149);
    border-right-color: rgb(27, 31, 39);
    border-top-color: rgb(126, 135, 149);
    border-bottom-color: rgb(27, 31, 39);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.character-diagnostics-item-selected {
    background-color: rgba(79, 167, 255, 0.35);
    border-left-color: rgb(158, 214, 255);
    border-right-color: rgb(50, 98, 140);
    border-top-color: rgb(158, 214, 255);
    border-bottom-color: rgb(50, 98, 140);
}

.character-diagnostics-icon {
    width: 100%;
    height: 100%;
    unity-text-align: middle-center;
    background-color: transparent;
    color: rgb(220, 232, 255);
    font-size: 14px;
    unity-font-style: bold;
    -unity-font-style: bold;
}

.character-diagnostics-item-name {
    display: none;
}

.character-diagnostics-selected-name {
    color: rgb(240, 245, 255);
    unity-font-style: bold;
    margin-bottom: 4px;
}

.character-diagnostics-row {
    color: rgb(198, 211, 234);
    font-size: 12px;
    margin-bottom: 2px;
}

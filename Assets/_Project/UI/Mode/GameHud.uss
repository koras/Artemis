.hud-root {
    flex-grow: 1;
}

.tool-panel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    max-width: 520px;
    justify-content: flex-end;
    gap: 8px;
}

.tool-panel > Button {
    min-width: 110px;
    height: 36px;
    font-size: 14px;
}

.task-queue-panel {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 360px;
    max-height: 70%;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.45);
}

#task-queue-title {
    font-size: 16px;
    unity-font-style: bold;
    margin-bottom: 8px;
    color: rgb(240, 240, 240);
}

.task-queue-list {
    flex-grow: 1;
}

.resource-inventory-panel {
    position: absolute;
    right: 16px;
    top: 76px;
    width: 220px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.45);
}

.game-time-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 260px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.45);
}

#game-time-label {
    font-size: 15px;
    unity-font-style: bold;
    color: rgb(245, 245, 245);
    white-space: normal;
}

#resource-inventory-title {
    font-size: 16px;
    unity-font-style: bold;
    margin-bottom: 8px;
    color: rgb(240, 240, 240);
}

.resource-inventory-list {
    flex-grow: 1;
}

.resource-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.resource-row-name {
    font-size: 14px;
    color: rgb(230, 230, 230);
}

.resource-row-amount {
    font-size: 14px;
    unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.offers-open-btn {
    position: absolute;
    right: 16px;
    top: 56px;
    min-width: 120px;
    height: 34px;
    background-color: rgb(53, 59, 69);
    color: rgb(232, 180, 90);
    unity-font-style: bold;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgb(154, 119, 81);
    border-right-color: rgb(61, 47, 30);
}

.shop-open-btn {
    position: absolute;
    left: 50%;
    top: 16px;
    min-width: 150px;
    height: 34px;
    margin-left: -75px;
    background-color: rgb(53, 59, 69);
    color: rgb(232, 180, 90);
    unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(154, 119, 81);
    border-right-color: rgb(61, 47, 30);
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
}

.offers-open-btn.blink {
    background-color: rgba(255, 210, 64, 0.95);
    color: rgb(20, 20, 20);
}

.offers-panel {
    position: absolute;
    left: 50%;
    top: 72px;
    width: 1400px;
    height: 640px;
    margin-left: -700px;
    padding: 12px;
    background-color: rgb(18, 22, 31);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(201, 160, 107);
    border-right-color: rgb(61, 47, 30);
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
}

.colony-event-banner {
    position: absolute;
    left: 50%;
    top: 72px;
    width: 520px;
    margin-left: -260px;
    padding: 12px 16px;
    background-color: rgba(18, 22, 31, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(201, 160, 107);
    border-right-color: rgb(61, 47, 30);
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
    display: none;
}

.colony-event-banner-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.colony-event-banner-title {
    font-size: 18px;
    color: rgb(245, 220, 150);
    unity-font-style: bold;
    flex-grow: 1;
}

.colony-event-banner-description {
    font-size: 14px;
    color: rgb(231, 235, 241);
    white-space: normal;
    margin-bottom: 10px;
}

.colony-event-banner-ack-btn {
    align-self: center;
    min-width: 140px;
}

.offers-panel Button,
.offer-tooltip-buttons > Button,
.offer-col-actions > Button,
.offers-open-btn,
.shop-panel Button {
    height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(53, 59, 69);
    font-size: 16px;
    color: rgb(232, 180, 90);
    unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(154, 119, 81);
    border-right-color: rgb(61, 47, 30);
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
}

.offers-panel Button:hover,
.offer-tooltip-buttons > Button:hover,
.offer-col-actions > Button:hover,
.offers-open-btn:hover,
.shop-panel Button:hover {
    background-color: rgb(126, 135, 149);
    color: rgb(16, 19, 26);
}

.offers-panel Button:active,
.offer-tooltip-buttons > Button:active,
.offer-col-actions > Button:active,
.offers-open-btn:active,
.shop-panel Button:active,
.shop-open-btn:active {
    background-color: rgb(168, 80, 0);
    color: rgb(255, 255, 255);
}

.power-debug-panel {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 420px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
}

.power-debug-title {
    font-size: 35px;
    unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 6px;
}

.power-debug-row {
    font-size: 30px;
    color: rgb(220, 220, 220);
    margin-bottom: 2px;
}

.power-overlay-item {
    position: absolute;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    unity-text-align: upper-left;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(12, 16, 24, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(210, 225, 255, 0.52);
    border-right-color: rgba(210, 225, 255, 0.52);
    border-top-color: rgba(210, 225, 255, 0.52);
    border-bottom-color: rgba(210, 225, 255, 0.52);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.power-overlay-item-label {
    color: rgb(255, 255, 255);
    unity-text-align: upper-left;
    white-space: normal;
    unity-font-style: bold;
    -unity-font-style: bold;
}

.power-overlay-item-icon {
    margin-top: 2px;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-open-btn:hover {
    background-color: rgb(126, 135, 149);
    color: rgb(16, 19, 26);
}

.shop-panel {
    position: absolute;
    left: 50%;
    top: 72px;
    width: 1180px;
    height: 640px;
    margin-left: -590px;
    padding: 12px;
    background-color: rgb(18, 22, 31);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(201, 160, 107);
    border-right-color: rgb(61, 47, 30);
    border-top-color: rgb(201, 160, 107);
    border-bottom-color: rgb(61, 47, 30);
}

.shop-content {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
}

.shop-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    width: 100%;
    min-width: 0;
}

.shop-panel-title {
    font-size: 26px;
    unity-font-style: bold;
    color: rgb(246, 198, 121);
}

.shop-gold-label {
    margin-left: auto;
    margin-right: 12px;
    color: rgb(255, 210, 125);
    font-size: 18px;
    unity-font-style: bold;
}

.shop-close-btn {
    min-width: 28px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
}

.shop-filter-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.shop-tab-row {
    flex-direction: row;
    gap: 8px;
    margin-bottom: 8px;
}

.shop-tab-btn {
    min-width: 140px;
    height: 36px;
    font-size: 15px;
}

.shop-orders-toggle-btn {
    margin-left: auto;
}

.shop-tab-btn-active {
    background-color: rgb(201, 160, 107);
    color: rgb(16, 19, 26);
}

.shop-tab-btn-orders-active {
    background-color: rgb(108, 166, 201);
    color: rgb(16, 19, 26);
}

.shop-filter-btn {
    min-width: 120px;
    height: 34px;
    font-size: 14px;
}

.shop-filter-btn-active {
    background-color: rgb(201, 160, 107);
    color: rgb(16, 19, 26);
}

.shop-list {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
}

.shop-table-header,
.shop-table-row {
    flex-direction: row;
    align-items: center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(201, 160, 107, 0.45);
    border-right-color: rgba(61, 47, 30, 0.85);
    border-bottom-color: rgba(61, 47, 30, 0.85);
}

.shop-table-header {

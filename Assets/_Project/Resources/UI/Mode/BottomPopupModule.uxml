<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Mode/GameHud.uss?fileID=7433441132597879392&amp;guid=cbf0a011acfc40458ef813093b593558&amp;type=3#GameHud"/>
    <ui:VisualElement name="bottom-popup-module" class="bottom-popup-panel">
        <ui:VisualElement class="bottom-popup-row"> 
            <ui:Button name="build-bridge-btn" text="Bridge" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.bridge.name" /></Bindings>
            </ui:Button>
            <ui:Button name="build-storage-btn" text="Storage" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.storage.name" /></Bindings>
            </ui:Button>
            <ui:Button name="regolith-processing-btn" text="Regolith Processing" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.regolithprocessingunit.name" /></Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="bottom-popup-row">
            <ui:Button name="sleep-module-btn" text="Sleep Module" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.sleepmodule.name" /></Bindings>
            </ui:Button>
            <ui:Button name="dinner-btn" text="Dining Station" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.dinnerstation.name" /></Bindings>
            </ui:Button>
            <ui:Button name="shower-btn" text="Shower" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="building.shower.name" /></Bindings>
            </ui:Button>
            <ui:Button name="build-life-module-btn" text="Build Life Module" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="action.life_module.build" /></Bindings>
            </ui:Button>
            <ui:Button name="cancel-life-module-btn" text="Cancel Life Module" class="menu-icon-btn">
                <Bindings><l:LocalizedString property="text" table="UI" entry="action.life_module.cancel" /></Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

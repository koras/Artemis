    m_Metadata:
      m_Items: []
  - m_Id: 4000000314
    m_Localized: Строит складской модуль.
    m_Metadata:
      m_Items: []
  - m_Id: 4000000315
    m_Localized: Строит установку обработки воды.
    m_Metadata:
      m_Items: []
  - m_Id: 4000000316
    m_Localized: Строит установку очистки воды.
    m_Metadata:
      m_Items: []
  - m_Id: 4000000317
